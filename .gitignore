# KEEP: Small research data files (unignore patterns)
# The following are tracked: *.pdb, *.fasta, *.csv, *.yaml, *.yml, *.png, *.log
# (These are kept by default; explicit unignore if nested within excluded dirs)
!data/**/*.pdb
!data/**/*.fasta
!data/**/*.csv
!data/**/*.yaml
!data/**/*.yml
!results/**/*.pdb
!results/**/*.fasta
!results/**/*.csv
!results/**/*.json
!figures/**/*.png
